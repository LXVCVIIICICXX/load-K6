# Настройки площадки. Скопируй в .env (это делает setup.sh) и заполни под свой стенд.
# .env в репозиторий не попадает — см. .gitignore.

# ── Адреса ───────────────────────────────────────────────────────────────────
# Обязательное: без API_URL ни один сценарий не стартует.
API_URL=https://api.stage.example.com
# Фронт. Если не задать, берётся API_URL без префикса api. —
# на большинстве стендов это верно.
SITE_URL=https://stage.example.com

# Имя площадки: под ним группируются прогоны в results/.
# По умолчанию — хост из API_URL, отдельно задавать нужно редко.
#STAND=api.stage.example.com

# Фронт закрыт basic-авторизацией nginx? Тогда «логин:пароль», иначе оставь пустым:
# без заголовка вся статика в прогоне ответит 401, и отчёт покажет поломку там,
# где её нет.
SITE_AUTH=
# Те же данные для морды и рекордера по отдельности.
SITE_LOGIN=
SITE_PASSWORD=

# ── Как устроен вход ─────────────────────────────────────────────────────────
# Инструмент не знает вход конкретного сайта: он описывается здесь. Подсмотреть
# проще всего в записи браузера (вкладка «Запись») или в спецификации API.
#
# Единственные подстановки в телах: $USER, $PASS и $resp.<путь через точку>
# в ответ первого шага. Числовой сегмент — индекс массива.

# GET перед входом, если сайт выдаёт CSRF-токен отдельным запросом.
CSRF_PATH=/sanctum/csrf-cookie
# POST входа. Без него не работают сценарии, которые входят.
LOGIN_PATH=/api/v1/login
LOGIN_BODY={"email":"$USER","password":"$PASS"}

# Второй шаг, если вход двухступенчатый (выбор профиля, подтверждение).
# Пусто — значит вход одношаговый.
LOGIN_CONFIRM_PATH=
LOGIN_CONFIRM_BODY=

# Необязательные: «я вошёл?» и выход.
PROBE_PATH=
LOGOUT_PATH=

# Где в ответе на вход лежит id вошедшего — им подменяются id в путях
# сценариев, собранных из записи.
USER_ID_PATH=data.id

# Имя куки и заголовка с CSRF-токеном. Пусто — сайт токен в куке не носит.
XSRF_COOKIE=XSRF-TOKEN
XSRF_HEADER=X-XSRF-TOKEN

# ── Профили стенда ───────────────────────────────────────────────────────────
# Сценарии никого не заводят: профили должны существовать заранее.
# ВАЖНО: неверный пароль на многих сайтах блокирует учётку на десятки минут,
# поэтому проверь вход руками до первого прогона.
#
# Роль — метка, которую придумываете вы: user, reviewer, admin, buyer. Списка
# ролей у инструмента нет. Из метки складывается имя переменных (латиницей):
#   user → USER_EMAIL / USER_PASS,  admin → ADMIN_EMAIL / ADMIN_PASS
# Теми же метками помечены профили в users.json и запросы в requests.json.
USER_EMAIL=user@example.com
USER_PASS=
REVIEWER_EMAIL=
REVIEWER_PASS=

# Какой ролью ходит сценарий, который ходит одной ролью (разгон одного запроса,
# вытеснение). Из морды подставляется первый включённый профиль.
ROLE=user

# ── Тест вытеснения (необязательно) ──────────────────────────────────────────
# Лёгкие запросы, которыми держится фон, через запятую. Тяжёлый выбирается
# в морде, а фон задаётся здесь: он зависит от сайта, а не от прогона.
BG_PATHS=

# ── Разбор записей браузера (необязательно) ──────────────────────────────────
# Сетевая база до стенда в миллисекундах: столько уходит на дорогу туда-обратно
# даже у запроса, который ничего не считает. Вычитается при оценке серверного
# времени. Замерить просто: время самого пустого ответа в записи.
NET_BASE=0
# По каким кускам пути запрос считается запросом к бэкенду, а не статикой.
# Пути входа отсюда добавляются сами.
API_HINTS=/api/,/graphql,/rpc/

# ── Куда складывать данные ───────────────────────────────────────────────────
# har/ и results/ по умолчанию создаются рядом с кодом. LOAD_ROOT нужен, только
# если записи и прогоны уже накоплены в другом каталоге.
#LOAD_ROOT=/путь/к/данным

# Порт локальной морды.
WEB_PORT=5057

# ── Метрики сервера (необязательно) ──────────────────────────────────────────
# Beszel — CPU/сеть/диск/контейнеры стенда в отчёте прогона. Без него отчёт
# соберётся, просто без серверных графиков. Эти же поля правятся в морде,
# вкладка «Настройки» — то, что введено там, сильнее .env.
BESZEL_URL=
BESZEL_EMAIL=
BESZEL_PASSWORD=
BESZEL_SYSTEM_ID=

# Префикс имён контейнеров на стенде: myproject-backend-fpm-1 → в легенде «fpm».
CONTAINER_PREFIX=

# ── Laravel Telescope (необязательно) ────────────────────────────────────────
# Сверка HAR-записи с тем, что видел бэкенд: медленные запросы, SQL, очереди.
# Нужен, только если стенд на Laravel и Telescope на нём включён.
TELESCOPE_URL=
TELESCOPE_EMAIL=
TELESCOPE_PASSWORD=
TELESCOPE_COOKIE=
